#!/usr/bin/env bash
# Record a coding agent's state for the tmux status-bar indicator.
#
# Usage: agent-status <busy|wait|done> [--json]
# Reads hook JSON from stdin for the project cwd. --json emits an empty JSON
# response for hook events whose caller requires one.
set -uo pipefail

state=${1:-}
output=${2:-}
[[ "$state" == busy || "$state" == wait || "$state" == done ]] || exit 0
[[ -z "$output" || "$output" == --json ]] || exit 0

cwd=$(jq -r '.cwd // empty' 2>/dev/null) || cwd=""
sess=""
if [[ -n "${TMUX_PANE:-}" ]]; then
  sess=$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null) || true
fi

if [[ -n "$sess" ]]; then
  status_dir=${XDG_CACHE_HOME:-$HOME/.cache}/agent-status
  status_file=$status_dir/$sess
  wanted=$(printf '%s\t%s' "$state" "$cwd")
  current=$(sed -n '1p' "$status_file" 2>/dev/null || true)
  if [[ "$current" != "$wanted" ]]; then
    mkdir -p "$status_dir"
    printf '%s\n' "$wanted" > "$status_file"
  fi
fi

if [[ "$output" == --json ]]; then
  printf '{}\n'
fi
