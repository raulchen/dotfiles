#!/usr/bin/env bash
# Adapt Codex lifecycle hook events to the shared tmux agent-status protocol.
set -uo pipefail

payload=$(cat)
event=""
cwd=""
IFS=$'\t' read -r event cwd < <(
  printf '%s' "$payload" \
    | jq -r '[.hook_event_name // "", .cwd // ""] | @tsv' 2>/dev/null
) || true

case "$event" in
  UserPromptSubmit|PreToolUse|PermissionRequest)
    state=busy
    ;;
  Stop)
    state=wait
    ;;
  SessionEnd)
    state=done
    ;;
  *)
    exit 0
    ;;
esac

# A shared app-server daemon retains the tmux context of the session that
# started it. Find the Sidekick pane for this hook's cwd instead of trusting
# that inherited context, which may belong to another project.
while IFS=$'\t' read -r sess pane_cwd pane_cmd; do
  [ "$pane_cwd" = "$cwd" ] || continue
  [ "$pane_cmd" = codex ] || continue
  case "$sess" in
    codex-*)
      dir=${XDG_CACHE_HOME:-$HOME/.cache}/agent-status
      mkdir -p "$dir"
      printf '%s\t%s\n' "$state" "$cwd" > "$dir/$sess"
      ;;
  esac
done < <(tmux list-panes -a -F $'#{session_name}\t#{pane_current_path}\t#{pane_current_command}' 2>/dev/null)

# Stop requires valid JSON on stdout even when the hook has no model-facing
# result. Other events accept an empty successful response.
if [ "$event" = Stop ]; then
  printf '{}\n'
fi
