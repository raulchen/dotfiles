{
  "description": "Expose Codex lifecycle state to tmux and retitle sessions when their first turn ends.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/libexec/agent-status busy",
            "timeout": 1
          },
          {
            "type": "command",
            "command": "~/dotfiles/libexec/codex-retitle --watch",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/libexec/agent-status busy",
            "timeout": 1
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/libexec/agent-status busy",
            "timeout": 1
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/libexec/agent-status done",
            "timeout": 1
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/libexec/agent-status wait --json",
            "timeout": 1
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/libexec/agent-status done",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
