#!/usr/bin/env node
// List transcript-bearing threads currently loaded by the managed Codex daemon.
// Usage: ~/dotfiles/libexec/codex-live-threads <absolute-cwd>
// Prints a JSON array. Failures are silent so callers can fall back to disk.
"use strict";

const { connect } = require("./codex-rpc.cjs");
const cwd = process.argv[2];
if (!cwd || !cwd.startsWith("/") || typeof WebSocket !== "function") process.exit(2);

async function main() {
  const timer = setTimeout(() => process.exit(1), 3000);
  let rpc;
  try {
    rpc = await connect("dotfiles_transcript_viewer", 2000);
    const threads = [];
    let cursor = null;
    do {
      const page = await rpc.call("thread/list", {
        cwd, cursor, limit: 100, sortKey: "updated_at", sortDirection: "desc",
        sourceKinds: [
          "cli", "vscode", "exec", "appServer", "subAgent", "subAgentReview",
          "subAgentCompact", "subAgentThreadSpawn", "subAgentOther", "unknown",
        ],
        useStateDbOnly: true,
      });
      threads.push(...page.data);
      cursor = page.nextCursor;
    } while (cursor);

    const seen = new Set();
    const live = threads.filter((thread) => {
      if (typeof thread?.id !== "string" || seen.has(thread.id)) return false;
      if (thread.cwd !== cwd || thread.parentThreadId != null) return false;
      if (thread.status?.type === "notLoaded" || typeof thread.path !== "string") return false;
      seen.add(thread.id);
      return true;
    });
    process.stdout.write(JSON.stringify(live) + "\n");
  } finally {
    clearTimeout(timer);
    rpc?.close();
  }
}

main().catch(() => { process.exitCode = 1; });
